{
  "name": "itto",
  "private": true,
  "version": "0.0.0",
  "description": "AI Minecraft co-op buddy: follows you, helps out, and hangs in your Discord call.",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun test",
    "doctor": "bun scripts/doctor.ts",
    "bot": "bun --watch apps/mc-bot/src/index.ts",
    "bot:dev": "MC_AUTH=offline MC_SERVER_HOST=localhost MC_SERVER_PORT=25565 MC_BOT_USERNAME=itto MC_OWNER_USERNAME=dev BRAIN_ENABLED=false bun --watch apps/mc-bot/src/index.ts",
    "drive": "bun scripts/drive.ts",
    "hello": "bun apps/mc-bot/scripts/hello-bot.ts",
    "brain": "bun apps/brain-deepseek/src/index.ts",
    "brain:smoke": "bun apps/brain-deepseek/scripts/smoke-test.ts",
    "train:export": "bun scripts/train-export.ts",
    "study:wiki": "bun apps/brain-deepseek/scripts/study-wiki.ts",
    "web": "bun run --filter @itto/web dev",
    "mc:versions": "bun apps/mc-bot/scripts/list-versions.ts",
    "op:bot": "bun apps/mc-bot/scripts/op-bot.ts",
    "op:auto": "bun apps/mc-bot/scripts/op-bot.ts --auto",
    "mc:up": "docker compose -f infra/docker-compose.yml up -d mc",
    "mc:down": "docker compose -f infra/docker-compose.yml down",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist apps/web/.next"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/bun": "^1.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "patchedDependencies": {
    "minecraft-protocol@1.66.2": "patches/minecraft-protocol@1.66.2.patch"
  }
}
